{
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 1,
  "exclusive": true,
  "gtk-layer-shell": true,
  "passthrough": false,
  "fixed-center": false,
  "expand-center": true,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "custom/empty"
  ],

  "modules-right": [
    "battery",
    "clock",
    "tray",
    "custom/notification"
  ],

  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": true,
    "active-only": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mons-per-row": 1,
      "weeks-pos": "",
      "on-scroll": 1
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },

  "custom/empty": {
    "format": " ",
    "tooltip": false
  },

  "custom/notification": {
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -t -sw",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜"
    }
  }
}
