{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "{{colors.primary.dark.hex}}",
      "2": "{{colors.secondary.dark.hex}}",
      "3": "{{colors.tertiary.dark.hex}}",
      "4": "{{colors.error.dark.hex}}",
      "5": "{{colors.on_surface.dark.hex}}",
      "6": "{{colors.outline.dark.hex}}",
      "7": "{{colors.surface_variant.dark.hex}}",
      "8": "{{colors.primary_container.dark.hex}}"
    }
  },
  "display": { "separator": " │ " },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages",
    "shell", "wm", "terminal",
    "cpu", "gpu", "memory", "disk", "localip", "battery",
    "break", "colors"
  ]
}
