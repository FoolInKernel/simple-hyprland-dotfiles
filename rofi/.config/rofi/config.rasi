configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    matching: "normal";
    sort: true;
    case-sensitive: false;
    cycle: true;
    sidebar-mode: false;
}
//@theme "white"

@theme "/usr/share/rofi/themes/android_notification.rasi"
